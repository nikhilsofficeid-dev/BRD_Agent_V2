# Copy to BRD_Agent_V2/.env  (adk web and run.py load it automatically)

# --- Model: Vertex AI (auth: gcloud auth application-default login) ----------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=heypm-511616
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Storage -----------------------------------------------------------------
# local = folders under BRD_Agent_V2/local_data (transcripts/, templates/, meetings/, outputs/)
# gcp   = GCS buckets + Firestore
STORAGE_BACKEND=gcp

# Transcripts: gs://TRANSCRIPT_BUCKET/TRANSCRIPT_PREFIX/<meeting_id>.txt|.vtt|.json|.md
#          or: gs://TRANSCRIPT_BUCKET/TRANSCRIPT_PREFIX/<meeting_id>/<any transcript file>
TRANSCRIPT_BUCKET=heypm-511616-meetings
TRANSCRIPT_PREFIX=transcripts

# Firestore
FIRESTORE_DATABASE=(default)
FIRESTORE_MEETINGS_COLLECTION=meetings
FIRESTORE_TEMPLATES_COLLECTION=brd_templates

# BRD templates: auto = Firestore collection, then GCS folder, then the bundled default
TEMPLATE_SOURCE=auto
# TEMPLATE_BUCKET defaults to TRANSCRIPT_BUCKET
TEMPLATE_PREFIX=templates/brd

# Generated BRDs: gs://OUTPUT_BUCKET/OUTPUT_PREFIX/<meeting_id>/BRD-....docx (+ .md)
# OUTPUT_BUCKET defaults to TRANSCRIPT_BUCKET
OUTPUT_PREFIX=brds

APP_TIMEZONE=Asia/Kolkata

# --- Actions -------------------------------------------------------------------
# true = confirm still works end to end, but nothing is emailed and JIRA is not touched
DRY_RUN=true
JIRA_PROJECT_KEY=FINAUTO
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
